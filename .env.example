# =============================================================================
# AuditKit Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
#
#   cp .env.example .env
#
# Variables marked [REQUIRED] must be set for the application to function.
# Variables marked [OPTIONAL] have sensible defaults or enable extra features.
# =============================================================================


# -----------------------------------------------------------------------------
# Database (Docker / PostgreSQL)
# -----------------------------------------------------------------------------

# [OPTIONAL] PostgreSQL credentials used by docker-compose to initialize the DB.
# Defaults shown below. Change in production.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=auditkit


# -----------------------------------------------------------------------------
# API Server (apps/api)
# -----------------------------------------------------------------------------

# [REQUIRED] PostgreSQL connection string.
# Must match the credentials above when running locally with Docker.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auditkit

# [OPTIONAL] Comma-separated list of emails that receive the sysadmin role
# on signup. Sysadmin accounts bypass billing quotas.
ADMIN_EMAILS=

# [OPTIONAL] Port the API server listens on.
# Default: 3001
PORT=3001

# [OPTIONAL] Comma-separated list of origins allowed by CORS.
# Default: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# [OPTIONAL] Public-facing API URL, used in the generated OpenAPI spec.
# Default: http://localhost:3001
API_URL=http://localhost:3001

# [OPTIONAL] Semantic version string reported by the API.
# Default: 0.1.0
API_VERSION=0.1.0

# [OPTIONAL] Frontend URL used when generating links in emails or redirects.
# Default: http://localhost:3000
FRONTEND_URL=http://localhost:3000

# [REQUIRED for billing] Stripe secret key (sk_test_... or sk_live_...).
# Only required if Stripe billing features are enabled.
# SECURITY: Never commit a real key. Use restricted keys in production.
STRIPE_SECRET_KEY=

# [REQUIRED for billing webhooks] Stripe webhook signing secret (whsec_...).
# Obtain from the Stripe Dashboard -> Webhooks -> Signing secret.
STRIPE_WEBHOOK_SECRET=

# [REQUIRED for event signing] AES-256 encryption key used to encrypt
# per-project event-signing keys at rest. Must be at least 32 characters.
# Generate with:  openssl rand -hex 32
# SECURITY: Rotate carefully -- existing encrypted keys become unreadable.
SIGNING_KEY_ENCRYPTION_KEY=

# [OPTIONAL] Absolute path to a MaxMind GeoLite2-City.mmdb database file.
# Enables IP-based geolocation enrichment on audit events.
# Download from: https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
GEOIP_DB_PATH=


# -----------------------------------------------------------------------------
# Redis (required for rate limiting and event queue)
# -----------------------------------------------------------------------------

# [REQUIRED] Redis connection URL. Used by rate limiting (ioredis) and
# BullMQ event queue. Must be running for the API to start.
REDIS_URL=redis://localhost:6379


# -----------------------------------------------------------------------------
# SIEM Credential Encryption
# -----------------------------------------------------------------------------

# [REQUIRED for SIEM integrations] AES-256-GCM key used to encrypt SIEM
# credentials (API keys, tokens) at rest in the database.
# Generate with:  openssl rand -base64 32
SIEM_ENCRYPTION_KEY=your-siem-encryption-key-here


# -----------------------------------------------------------------------------
# Email Service
# -----------------------------------------------------------------------------

# [OPTIONAL] Resend API key for transactional emails (team invites, alerts).
# Falls back to console logging when not configured.
RESEND_API_KEY=re_your_api_key_here

# [OPTIONAL] Sender address for outbound emails.
EMAIL_FROM=AuditKit <noreply@auditkit.dev>


# -----------------------------------------------------------------------------
# Export Storage (S3-compatible)
# -----------------------------------------------------------------------------

# [OPTIONAL] S3-compatible object storage for export files.
# Falls back to database storage when not configured.
EXPORT_STORAGE_BUCKET=auditkit-exports
EXPORT_STORAGE_REGION=us-east-1
EXPORT_STORAGE_ENDPOINT=http://localhost:9000  # MinIO for local dev
EXPORT_STORAGE_ACCESS_KEY=minioadmin
EXPORT_STORAGE_SECRET_KEY=minioadmin


# -----------------------------------------------------------------------------
# Stripe Price IDs
# -----------------------------------------------------------------------------

# [OPTIONAL] Stripe price IDs for billing plans. Override for production.
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_BUSINESS=price_business_monthly
STRIPE_PRICE_SUPERSIZE=price_supersize_monthly


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# [OPTIONAL] Log level for pino structured logger.
# Values: fatal, error, warn, info, debug, trace
# Default: info
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# Web Frontend (apps/web)
# -----------------------------------------------------------------------------

# [REQUIRED] Base URL the frontend uses to reach the API.
# In production this should point to your deployed API.
NEXT_PUBLIC_API_URL=http://localhost:3001

# [OPTIONAL] API key embedded in the client-side bundle for SDK demo/docs.
# SECURITY: This value is exposed to the browser. Only use a public/read-only
# key here. Never embed a secret or admin-level key.
NEXT_PUBLIC_AUDITKIT_API_KEY=
