# Copy to deploy/.env on the VPS. Never commit the real file.
AUDITKIT_PUBLIC_HOST=auditkit.dev
AUDITKIT_SITE_URL=https://auditkit.dev
AUDITKIT_ANCHORS=rekor,ots
# Our nginx sets X-Real-IP from $remote_addr, so it is trustworthy. Never set this without a proxy that overwrites the header.
AUDITKIT_PROXY_TRUST=x-real-ip
AUDITKIT_ANCHOR_INTERVAL=300
# Ed25519 receipt key and P-256 anchor key, base64 PKCS8. Leave unset on first boot: the server generates
# them into /data and prints nothing; back up /data/signing.key and /data/anchor.key.
# AUDITKIT_SIGNING_KEY=
# AUDITKIT_ANCHOR_KEY=
# Resend: sign-in emails. With an https site URL the server refuses to start without it, unless
# AUDITKIT_ALLOW_MAIL_STUB=1 (private smoke test only: links are written to the container log).
# RESEND_API_KEY=
AUDITKIT_MAIL_FROM="AuditKit <login@auditkit.dev>"
# Stripe: unset => upgrade buttons return 501 "billing not configured".
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_BUSINESS=
# Project id every new account can read (directory reviewers get populated data). Create it with `pnpm --filter @auditkit/server seed`.
# AUDITKIT_SANDBOX_PROJECT=
