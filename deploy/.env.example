# Copy to deploy/.env on the VPS. Never commit the real file.
AUDITKIT_PUBLIC_HOST=auditkit.dev
AUDITKIT_SITE_URL=https://auditkit.dev
AUDITKIT_ANCHORS=rekor,ots
AUDITKIT_ANCHOR_INTERVAL=300
# Ed25519 receipt key and P-256 anchor key, base64 PKCS8. Leave unset on first boot: the server generates
# them into /data and prints nothing; back up /data/signing.key and /data/anchor.key.
# AUDITKIT_SIGNING_KEY=
# AUDITKIT_ANCHOR_KEY=
# Resend: sign-in emails. Unset => links print to the container log (fine for the first smoke test).
# RESEND_API_KEY=
AUDITKIT_MAIL_FROM="AuditKit <login@auditkit.dev>"
# Stripe: unset => upgrade buttons return 501 "billing not configured".
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_BUSINESS=
