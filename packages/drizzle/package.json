{
  "name": "@auditkit/drizzle",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@auditkit/sdk": "workspace:*",
    "@auditkit/shared": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.30"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "drizzle-orm": "^0.39.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0"
  },
  "license": "AGPL-3.0-or-later"
}
