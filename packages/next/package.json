{
  "name": "@auditkit/next",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@auditkit/sdk": "workspace:*",
    "@auditkit/shared": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=14"
  },
  "devDependencies": {
    "next": "^15.2.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  },
  "license": "AGPL-3.0-or-later",
  "description": "AuditKit middleware and utilities for Next.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/AuditKitDev/auditkit.git",
    "directory": "packages/next"
  },
  "homepage": "https://auditkit.dev/docs",
  "bugs": "https://github.com/AuditKitDev/auditkit/issues",
  "publishConfig": {
    "access": "public"
  }
}
