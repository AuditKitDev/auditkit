---
import { PLANS, INCLUDED_EVERYWHERE } from "../lib/plans";
interface Props { compact?: boolean; /** h3 under a section h2 (homepage); h2 directly under the page h1 (/pricing). */ headingLevel?: 2 | 3 }
const { compact = false, headingLevel = 3 } = Astro.props;
const H = headingLevel === 2 ? "h2" : "h3";
---
<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
  {PLANS.map((p) => (
    <section class:list={["card flex flex-col p-5", p.highlight && "border-accent/60 ring-1 ring-accent/40"]} aria-labelledby={`plan-${p.id}`}>
      <H id={`plan-${p.id}`} class="font-semibold">{p.name}</H>
      <p class="mt-3"><span class="text-3xl font-semibold tracking-tight">{p.price}</span> <span class="text-sm text-muted">{p.period}</span></p>
      <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm">
        <dt class="text-faint">Events</dt><dd class="text-fg">{p.events}</dd>
        <dt class="text-faint">Retention</dt><dd class="text-fg">{p.retention}</dd>
        <dt class="text-faint">Anchor</dt><dd class="text-fg">{p.anchor}</dd>
        <dt class="text-faint">Support</dt><dd class="text-fg">{p.support}</dd>
      </dl>
      <a href={p.cta.href} class:list={["btn mt-auto pt-2 w-full", p.highlight && "btn-primary"]} style="margin-top: 1.25rem">{p.cta.label}</a>
    </section>
  ))}
</div>
{!compact && (
  <div class="card mt-4 p-5">
    <p class="font-medium">Every plan, including Free, has the same features</p>
    <p class="mt-1 text-sm text-muted">Plans differ only in monthly events, payload retention, anchor cadence and support. Nothing below is gated by plan.</p>
    <ul class="mt-3 grid gap-x-6 gap-y-1.5 text-sm text-muted sm:grid-cols-2 lg:grid-cols-4">
      {INCLUDED_EVERYWHERE.map((e) => <li class="flex gap-2"><span class="text-accent" aria-hidden="true">›</span>{e}</li>)}
    </ul>
  </div>
)}
<p class="mt-4 text-xs text-faint">Retention is payload retention: hashes, signatures and anchors are kept so old exports still verify. Billing through Stripe Checkout; no seats, no metering beyond a monthly event counter. Prices in USD. <span class="font-mono">[OWNER: confirm Stripe prices]</span></p>
