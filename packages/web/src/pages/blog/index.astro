---
import Base from "../../layouts/Base.astro";
const posts = Object.entries(import.meta.glob<{ frontmatter: { title: string; description: string; date: string; tags?: string[] } }>("./*.md", { eager: true }))
  .map(([path, m]) => ({ href: `/blog/${path.replace("./", "").replace(/\.md$/, "")}`, ...m.frontmatter }))
  .sort((a, b) => (a.date < b.date ? 1 : -1));
---
<Base title="Blog: audit log integrity, anchoring, erasure" description="Definitions and design notes on tamper-evident audit logs: hash chains, Merkle roots, Rekor and OpenTimestamps anchoring, crypto-shredding, signed receipts, MCP.">
  <section class="mx-auto max-w-3xl py-12">
    <h1 class="text-3xl font-semibold sm:text-4xl">Blog</h1>
    <p class="mt-3 text-lg text-muted">Design notes from the people who built it. Each post opens with the answer. <a href="/rss.xml" class="text-accent underline">RSS</a></p>
    <ul class="mt-8 divide-y divide-line">
      {posts.map((p) => (
        <li class="py-5">
          <a href={p.href} class="group block">
            <p class="font-mono text-xs text-faint"><time datetime={p.date}>{p.date}</time>{p.tags?.length ? ` · ${p.tags.join(", ")}` : ""}</p>
            <h2 class="mt-1 text-xl font-semibold group-hover:text-accent">{p.title}</h2>
            <p class="mt-1 text-sm text-muted">{p.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
