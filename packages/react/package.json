{
  "name": "@auditkit/react",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts --external react --external react-dom",
    "dev": "tsup src/index.tsx --format esm --dts --external react --external react-dom --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@auditkit/shared": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0"
  },
  "license": "AGPL-3.0-or-later",
  "description": "Embeddable audit log viewer for React",
  "repository": {
    "type": "git",
    "url": "https://github.com/AuditKitDev/auditkit.git",
    "directory": "packages/react"
  },
  "homepage": "https://auditkit.dev/docs",
  "bugs": "https://github.com/AuditKitDev/auditkit/issues",
  "publishConfig": {
    "access": "public"
  }
}
