{
  "name": "@auditkit/verify",
  "version": "2.0.0-alpha.0",
  "description": "Offline verifier for AuditKit export files: re-hashes, walks the chain, rebuilds Merkle roots, checks public anchors.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": "./dist/index.js" },
  "bin": { "auditkit-verify": "./dist/cli.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@auditkit/anchor-ots": "workspace:*",
    "@auditkit/anchor-rekor": "workspace:*",
    "@auditkit/core": "workspace:*"
  },
  "devDependencies": {
    "@auditkit/server": "workspace:*"
  }
}
